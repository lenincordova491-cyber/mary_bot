# Número del dueño del bot (formato internacional, sin + ni espacios). Ej: 521234567890
OWNER_NUMBER=

# Número al que se enviará el código de emparejamiento de 8 dígitos.
# Si se deja vacío se usa OWNER_NUMBER.
PAIRING_NUMBER=

# Prefijo de comandos
PREFIX=.

# Nombre de la sesión (informativo)
SESSION_NAME=mary_uwu

# OpenAI (módulo de IA: .ai y .imagine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# Límite de tamaño para enviar archivos (MB)
MAX_FILE_SIZE_MB=100

# Rutas de binarios externos (opcionales; por defecto se buscan en el PATH)
# GALLERY_DL_PATH=gallery-dl
# YTDLP_PATH=yt-dlp

# Nivel de logs de pino (silent | warn | info | debug | trace)
# LOG_LEVEL=warn
